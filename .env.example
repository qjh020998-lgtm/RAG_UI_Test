# ============================================================
# RAG Agent Environment Variables
# Copy this file to .env and fill in actual values
# All variables use RAG_ prefix (pydantic-settings env_prefix)
# ============================================================

# ── Milvus ──
RAG_MILVUS_URI=http://localhost:19530
RAG_MILVUS_COLLECTION_NAME=erp_knowledge
RAG_MILVUS_COLLECTION_ALIAS=erp_knowledge_latest
RAG_MILVUS_TIMEOUT=30.0

# ── BGE-M3 Embedding ──
RAG_EMBEDDING_MODEL_PATH=D:\huggingface_cache\modelscope\models\BAAI--bge-m3\snapshots\master
RAG_EMBEDDING_DEVICE=cpu
RAG_EMBEDDING_USE_FP16=false
RAG_EMBEDDING_BATCH_SIZE=32
RAG_EMBEDDING_DENSE_DIM=1024
RAG_EMBEDDING_MAX_LENGTH=8192

# ── LLM (Phase 3 AIGC + Reranker) ──
RAG_LLM_API_KEY=your-api-key-here
RAG_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RAG_LLM_FAST_MODEL=qwen-turbo
RAG_LLM_STRONG_MODEL=qwen-plus
RAG_LLM_TEMPERATURE=0.1
RAG_LLM_MAX_TOKENS=4096

# ── Search ──
RAG_SEARCH_TOP_K=10
RAG_SEARCH_DENSE_TOP_K=20
RAG_SEARCH_SPARSE_TOP_K=20
RAG_SEARCH_RRF_K=60
RAG_SEARCH_SCORE_THRESHOLD=0.0
